{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "python build.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "backend/predictive_ai/{data/*.csv,artifacts/demand_model.cbm,artifacts/metrics.json}",
      "excludeFiles": "{frontend/node_modules/**,backend/venv/**,.venv/**,venv/**,backend/backups/**,**/*.sqlite3,screenshots/**,.git/**,tests/**,.freshcast-deploy/**}"
    }
  }
}
