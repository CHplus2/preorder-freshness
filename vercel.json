{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "python build.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/predictive_ai/data/*.csv,backend/predictive_ai/artifacts/demand_model.cbm,backend/predictive_ai/artifacts/metrics.json,backend/predictive_ai/artifacts/runtime-bundle.tar.gz}",
      "excludeFiles": "{**/node_modules/**,**/venv/**,{backend/backups,screenshots,.git,.venv,venv,tests,escrow,docs/evidence,.freshcast-deploy}/**,**/*.sqlite3,frontend/{public,scripts}/**,frontend/src/{components,contexts,features,pages,hooks,utils,assets}/**,**/test*.py}"
    }
  }
}
