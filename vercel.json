{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "python build.py",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{backend/predictive_ai/data/*.csv,backend/predictive_ai/artifacts/demand_model.cbm,backend/predictive_ai/artifacts/metrics.json,backend/predictive_ai/artifacts/runtime-bundle.tar.gz,frontend/src/contracts/preorderEscrow.json}",
      "excludeFiles": "{frontend/node_modules/**,frontend/public/**,frontend/scripts/**,frontend/src/components/**,frontend/src/contexts/**,frontend/src/features/**,frontend/src/pages/**,frontend/src/hooks/**,frontend/src/utils/**,frontend/src/assets/**,backend/venv/**,backend/**/test*.py,.venv/**,venv/**,backend/backups/**,**/*.sqlite3,screenshots/**,.git/**,tests/**,escrow/**,docs/evidence/**,.freshcast-deploy/**}"
    }
  }
}
