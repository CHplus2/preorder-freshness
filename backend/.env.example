# Copy to .env locally. Never commit .env or real credentials.
SECRET_KEY=replace-with-a-random-django-secret
DEBUG=True
# Local: omit DATABASE_URL to use backend/db.sqlite3.
# Vercel: required; get the PostgreSQL pooler URI from Supabase > Connect.
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER-HOST:6543/postgres
# For the private schema created by prepare_supabase:
# DATABASE_SCHEMA=django_app
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER-HOST:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vercel adds its generated domains automatically; add your custom domain above.
